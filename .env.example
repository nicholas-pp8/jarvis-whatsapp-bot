# Bot identity
BOT_NAME=Jarvis
# Command prefix (one or more characters), e.g. / or . or !
PREFIX=/
# Your WhatsApp number, digits only with country code, no + (e.g. 919876543210)
OWNER_NUMBER=
# Optional: number to pair. If empty, the bot asks in the console on first start.
PAIRING_NUMBER=

# Features
# View new WhatsApp statuses automatically (true/false)
AUTO_STATUS_VIEW=false
# Work in groups too (true/false)
ALLOW_GROUPS=true
# Only the owner can use commands (true/false)
OWNER_ONLY=false

# Folders
DOWNLOAD_FOLDER=./downloads
TEMP_FOLDER=./temp
AUTH_FOLDER=./auth
DATA_FOLDER=./data

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Limits
MAX_FILE_SIZE_MB=100
# Seconds a single download may run
MAX_DOWNLOAD_TIME=300
# Videos above this size are sent as a document instead of an inline video
MAX_INLINE_VIDEO_MB=64
# Highest video height to download (keeps files small)
MAX_VIDEO_HEIGHT=480
# Queue
MAX_CONCURRENT_DOWNLOADS=1
MAX_QUEUE_LENGTH=10
MAX_JOBS_PER_USER=2
# Minimum free disk space (MB) required to start a download
MIN_FREE_DISK_MB=150
# Seconds between commands per user (0 = off)
COMMAND_COOLDOWN=2
# Delete leftover temp folders older than this (minutes)
TEMP_MAX_AGE_MINUTES=30

# Optional: paths to external tools (auto-detected if empty)
YTDLP_PATH=
FFMPEG_PATH=
# Optional: Netscape cookies.txt for YouTube if it asks you to sign in
YTDLP_COOKIES=

# YouTube provider: leave empty to try the scraper first then yt-dlp, or set ytdlp for yt-dlp only
YT_PROVIDER=

# AI (/ask): fill any key you have. Providers are tried in this order: Gemini, Groq, OpenRouter
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides
GEMINI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=

# Timezone for scheduled group messages
BOT_TZ=Asia/Calcutta

# Text to speech
TTS_MAX_CHARS=500
TTS_TIMEOUT_MS=25000

# /remini: local Sharp works without credentials. External trials are owner-only.
# Set provider+budget only after owner approves provider disclosure and credits.
CLIPDROP_API_KEY=
REMINI_CLIPDROP_ENABLED=false
REMINI_CLIPDROP_BUDGET=0
PIXELBIN_API_TOKEN=
REMINI_PIXELBIN_ENABLED=false
REMINI_PIXELBIN_BUDGET=0
REPLICATE_API_TOKEN=
REMINI_REPLICATE_ENABLED=false
REMINI_REPLICATE_BUDGET=0
REMINI_REPLICATE_PAID_APPROVED=false
REPLICATE_ESRGAN_VERSION=e1f4a2081605342caf55ba4294914cf266dcdf738397cf8826b48cdae516137c

# Free trial adapters: disabled until approved/configured. No automatic retry or paid fallback.
SNAPEDIT_API_KEY=
REMINI_SNAPEDIT_ENABLED=false
# Credits, not requests: 2x costs4,4x costs7. Match verified trial balance.
REMINI_SNAPEDIT_BUDGET=0
# CodeFormer public Space anonymous is possible; token optional for account quota.
HF_TOKEN=
REMINI_CODEFORMER_ENABLED=false
# Lifetime local attempt cap, NOT GPU minutes or a promise of daily availability.
REMINI_CODEFORMER_BUDGET=0
REMINI_CODEFORMER_FREE_ONLY_UNLIMITED=false

# Phone info: disabled until free account, quota, terms and test are verified.
# Caps are lifetime attempts, deliberately not auto-reset by calendar.
VERIPHONE_API_KEY=
IPQS_API_KEY=
PHONEINFO_VERIPHONE_ENABLED=false
PHONEINFO_VERIPHONE_BUDGET=0
PHONEINFO_IPQS_ENABLED=false
PHONEINFO_IPQS_BUDGET=0
# Optional PHONEINFO_BUDGET_FILE; ledger contains counts/times, never numbers.
# DataCrawler third-party source, verified basic response for IN only. Disabled until approved runtime setup.
RAPIDAPI_API_KEY=
PHONEINFO_RAPIDAPI_ENABLED=false
PHONEINFO_RAPIDAPI_BUDGET=0
# Hard maximum 7 lifetime attempts until provider monthly reset is safely configured.
