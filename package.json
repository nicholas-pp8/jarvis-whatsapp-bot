    "ffmpeg-static": "^5.3.0",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.5",
    "validator": "^13.15.35",
    "yt-search": "^2.13.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
