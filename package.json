  "description": "Jarvis: a modular multifunctional WhatsApp bot (Baileys) with downloaders, AI, image tools and group management",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "setup:ytdlp": "node scripts/install-ytdlp.js",
